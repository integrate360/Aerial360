{
    "compilerOptions": {
      "target": "ESNext",                        // Use the latest ECMAScript features
      "module": "ESNext",                        // Use the latest module system
      "lib": ["DOM", "DOM.Iterable", "ESNext"],  // Include DOM and modern ECMAScript features
      "jsx": "react-jsx",  
      "allowJs": true,                           // Allow JavaScript files
      "checkJs": false,                          // Do not check types in JavaScript files
      "strict": true,                            // Enable strict type-checking options
      "noImplicitAny": true,                     // Disallow `any` type by default
      "strictNullChecks": true,                  // Enable strict null checking
      "strictFunctionTypes": true,               // Enable strict function types
      "strictBindCallApply": true,               // Check function calls with `.bind`, `.call`, and `.apply`
      "noImplicitThis": true,                    // Disallow `this` of type `any`
      "alwaysStrict": true,                      // Parse in strict mode and emit `"use strict"`
      "moduleResolution": "node",                // Use Node.js-style module resolution
      "esModuleInterop": true,                   // Enable compatibility with CommonJS
      "forceConsistentCasingInFileNames": true,  // Enforce consistent casing in module names
      "skipLibCheck": true,                      // Skip type checking of declaration files
      "isolatedModules": true,                   // Ensure each file can be transpiled individually
      "noEmit": true,                            // Prevent emitting JavaScript files
      "resolveJsonModule": true,                 // Allow importing `.json` files
      "baseUrl": "./",                           // Base path for imports
      "paths": {                                 // Define path aliases
        "@components/*": ["src/components/*"],
        "@utils/*": ["src/utils/*"],
        "@styles/*": ["src/styles/*"]
      }
    },
    "include": ["src"],                          // Files to include in the project
    "exclude": ["node_modules", "build", "dist"] // Files to exclude from the project
  }
  